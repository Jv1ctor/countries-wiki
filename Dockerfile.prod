# Estágio 1: Build da aplicação
FROM node:20-alpine AS build
WORKDIR /app

# 1. Instala o pnpm via npm para evitar os travamentos de rede do Corepack no Alpine
RUN npm install -g pnpm

# 2. Copia os arquivos de dependência primeiro
COPY package.json pnpm-lock.yaml* ./

# 3. Instala as dependências (removida a flag --frozen-lockfile para evitar falhas de desincronização)
RUN pnpm install

# 4. Copia o resto do código e gera o build
COPY . .
RUN pnpm build


# Estágio 2: Servidor Web (Nginx)
FROM nginx:alpine

# 5. Remove a configuração padrão do Nginx que vem na imagem
RUN rm -f /etc/nginx/conf.d/default.conf

# 6. Copia a sua configuração e garante que ela assuma o lugar da padrão
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 7. Copia os arquivos gerados no estágio de build para a pasta pública do Nginx
COPY --from=build /app/dist /usr/share/nginx/html

# Exposição da porta (deve bater com o painel do Coolify e com o seu nginx.conf)
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]